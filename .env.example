# Copy this file to .env and fill in your key.
# Never commit .env to version control.

# --- Pick one LLM provider ---

# Option A: Groq (free, fast – llama3 / mixtral)
GROQ_API_KEY=your_groq_key_here

# Option B: OpenAI
# OPENAI_API_KEY=your_openai_key_here

# --- Embedding model ---
# Defaults to a local sentence-transformer when no key is set.
# Set to "openai" to use text-embedding-3-small (requires OPENAI_API_KEY).
EMBEDDING_PROVIDER=local          # "local" | "openai"

# --- Retrieval config (can be left as-is) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_K=5                     # how many docs each retriever returns before merge
TOP_K=6                           # final chunks sent to LLM after hybrid merge
